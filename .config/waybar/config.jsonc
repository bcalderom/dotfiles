{
  "position": "top",
  "modules-left": [
    "ext/workspaces"
  ],
  "modules-center": [
    // "hyprland/window"
    "clock"
  ],
  "modules-right": [
    "battery",
    "backlight",
    "power-profiles-daemon",
    "pulseaudio",
    "network",
    "custom/storage",
    "temperature",
    "cpu",
    "memory",
    "privacy",
    "custom/notification"
  ],
  "ext/workspaces": {
    "all-outputs": false,
    "sort-by-name": true,
    "on-click": "activate"
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": [
        "",
        "",
        " "
      ]
    },
    "on-click": "pavucontrol"
  },
  "network": {
    "interval": 5,
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "󰈀  {ifname}",
    "format-disconnected": "󰖪",
    "tooltip": true,
    "tooltip-format": "{ifname}: {ipaddr}\n{essid}",
    "on-click": "nm-connection-editor"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    // "format": "",
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-discharging": "{icon} {capacity}%",
    // "format-plugged": "",
    "format-plugged": " {capacity}%",
    // "format-full": "",
    "format-full": " {capacity}%",
    // "format-not-charging": "",
    "format-not-charging": "{icon} {capacity}%",
    "format-icons": ["","","","",""],
    "tooltip": true
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  "clock": {
    // "format": "<span>   </span>{:%A, %b %d  %H:%M}",
    "format": "{:%A, %b %d - %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><span size=\"large\">{calendar}</span></tt>"
  },
  "custom/storage": {
    "interval": 30,
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/storage-status.sh"
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "scroll-step": 5,
    "min-brightness": 5,
    "tooltip-format": "Brillo: {percent}%"
  },
  "temperature": {
    "critical-threshold": 85,
    "format": " {temperatureC}°C"
  },
  "cpu": {
    "format": "  {usage}%",
    "interval": 2
  },
  "memory": {
    "interval": 5,
    "format": " {used:0.1f}G"
  },
  "privacy": {
    "icon-spacing": 6,
    "icon-size": 18,
    "transition-duration": 250,
    "modules": [
      {
        "type": "screenshare",
        "tooltip": true,
        "tooltip-icon-size": 20
      },
      {
        "type": "audio-in",
        "tooltip": true,
        "tooltip-icon-size": 20
      }
    ]
  },
  "custom/notification": {
    "tooltip": true,
    "format": "{icon} {0}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  }
}
