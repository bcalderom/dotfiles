{
  "position": "top",
  "modules-left": [
    "ext/workspaces"
  ],
  "modules-center": [
    // "hyprland/window"
    "clock"
  ],
  "modules-right": [
    "group/system-stats",
    "privacy",
    "battery",
    "group/controls"
  ],
  "group/system-stats": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 250,
      "transition-left-to-right": false,
      "click-to-reveal": true
    },
    "modules": [
      "custom/system-stats",
      "custom/storage",
      "temperature",
      "cpu",
      "memory"
    ]
  },
  "custom/system-stats": {
    "format": "󰍛",
    "tooltip-format": "Mostrar / ocultar recursos del sistema"
  },
  "group/controls": {
    "orientation": "horizontal",
    "modules": [
      "network",
      "pulseaudio",
      "power-profiles-daemon",
      "custom/notification"
    ]
  },
  "ext/workspaces": {
    "all-outputs": false,
    "sort-by-name": true,
    "on-click": "activate"
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "",
    "tooltip-format": "Volumen: {volume}% · {desc}",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "swaync-client -t -sw",
    "on-click-right": "pavucontrol"
  },
  "network": {
    "interval": 5,
    "format-wifi": "",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip": true,
    "tooltip-format": "{ifname}: {ipaddr}\n{essid}\nClic derecho: conexiones de red",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "nm-connection-editor"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    // "format": "",
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-discharging": "{icon} {capacity}%",
    // "format-plugged": "",
    "format-plugged": " {capacity}%",
    // "format-full": "",
    "format-full": " {capacity}%",
    // "format-not-charging": "",
    "format-not-charging": "{icon} {capacity}%",
    "format-icons": ["","","","",""],
    "tooltip": true
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip": true,
    "on-click": "swaync-client -t -sw",
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  "clock": {
    // "format": "<span>   </span>{:%A, %b %d  %H:%M}",
    "format": "{:%A, %b %d - %H:%M}",
    "tooltip": false,
    "on-click": "sh -c 'if command -v gsimplecal >/dev/null 2>&1; then export LC_ALL=en_GB.utf8 LOCPATH=\"${XDG_DATA_HOME:-$HOME/.local/share}/gsimplecal/locales${LOCPATH:+:$LOCPATH}\"; exec gsimplecal; else notify-send -a Calendario \"Calendario no instalado\" \"Instala el paquete gsimplecal para abrir el calendario.\"; fi'"
  },
  "custom/storage": {
    "interval": 30,
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/storage-status.sh"
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "scroll-step": 5,
    "min-brightness": 5,
    "tooltip-format": "Brillo: {percent}%"
  },
  "temperature": {
    "critical-threshold": 85,
    "format": " {temperatureC}°C"
  },
  "cpu": {
    "format": "  {usage}%",
    "interval": 2
  },
  "memory": {
    "interval": 5,
    "format": " {used:0.1f}G"
  },
  "privacy": {
    "icon-spacing": 6,
    "icon-size": 18,
    "transition-duration": 250,
    "modules": [
      {
        "type": "screenshare",
        "tooltip": true,
        "tooltip-icon-size": 20
      },
      {
        "type": "audio-in",
        "tooltip": true,
        "tooltip-icon-size": 20
      }
    ]
  },
  "custom/notification": {
    "tooltip": true,
    "format": "{icon} {0}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  }
}
