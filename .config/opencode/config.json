{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": "notify",
  "small_model": "openai/gpt-5.5",
  "subagent_depth": 1,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "agent": {
    "plan": {
      "color": "warning"
    },
    "general": {
      "permission": {
        "task": "deny"
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{file:/home/boris/.config/opencode/secrets/context7.token}"
      },
      "enabled": true
    },
    "jcodemunch": {
      "type": "local",
      "command": ["uvx", "jcodemunch-mcp==1.108.317"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.80",
        "--executable-path",
        "/usr/bin/chromium"
      ],
      "enabled": false
    },
    "wisemin-cenizas-franke": {
      "type": "local",
      "command": ["uvx", "mcp-grafana==1.3.0"],
      "enabled": false,
      "environment": {
        "GRAFANA_URL": "https://cenizas.wisemin.cl",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN_FILE": "/home/boris/.config/opencode/secrets/wisemin-cenizas-franke.token"
