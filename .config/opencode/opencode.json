{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": "notify",
  "small_model": "openai/gpt-5.5",
  "subagent_depth": 1,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "agent": {
    "plan": {
      "color": "warning"
    },
    "general": {
      "permission": {
        "task": "deny"
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{file:/home/boris/.config/opencode/secrets/context7.token}"
      },
      "enabled": true
    },
    "jcodemunch": {
      "type": "local",
      "command": ["uvx", "jcodemunch-mcp==1.108.317"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.80",
        "--executable-path",
        "/usr/bin/chromium"
      ],
      "enabled": false
    }
  }
}
