{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "update": "notify",
  "experimental": {
    "subagent_depth": 1
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" }
  ],
  "compaction": {
    "auto": true,
    "keep": { "tokens": 15000 },
    "buffer": 10000
  },
  "agents": {
    "title": {
      "model": "openai/gpt-5.5"
    },
    "plan": {
      "color": "#f9e2af"
    },
    "general": {
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{file:/home/boris/.config/opencode/secrets/context7.token}"
        },
        "oauth": false,
        "codemode": true,
        "disabled": false
      },
      "jcodemunch": {
        "type": "local",
        "command": ["uvx", "jcodemunch-mcp==1.108.357"],
        "codemode": true,
        "disabled": false
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@0.0.83",
          "--executable-path",
          "/usr/bin/chromium"
        ],
        "disabled": true
      }
    }
  }
}
