#!/usr/bin/env bash
# tds (Tmux Developer Session) - open a directory in a tmux dev layout.
# Run 'tds --help' for usage.
# Internal: tds --dirs --root PATH --depth N [-- QUERY...] prints the fzf list.

set -euo pipefail

ROOT="${PWD}"
DEPTH="2"
LAYOUT="3-panes-ide"
LEFT_PERCENT="40"
RIGHT_PERCENT="60"
RIGHT_TOP_PERCENT="80"
RIGHT_BOTTOM_PERCENT="20"
DEBUG="false"
DIRS_MODE="false"
INCLUDE_ZOXIDE="true"
DIRECTORY=""
NEW_SESSION="false"
OPENCODE_SESSION=""

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
# shellcheck source=scripts/tmux/tds/help.sh
. "$(dirname -- "${SELF}")/help.sh"

die() {
  echo "Error: $*" >&2
  exit 1
}

have() {
  command -v "$1" >/dev/null 2>&1
}

require_apps() {
  local missing=()
  local app

  for app in "$@"; do
    if ! have "${app}"; then
      missing+=("${app}")
    fi
  done

  if ((${#missing[@]} > 0)); then
    local label="tools"
    if ((${#missing[@]} == 1)); then
      label="tool"
    fi
    die "Missing required ${label}: ${missing[*]}"
  fi
}

debug_log() {
  if [[ "${DEBUG}" == "true" ]]; then
    echo "DEBUG: $*" >&2
  fi
}

escape_shell() {
  printf '%q' "$1"
}

ORIG_ARGS=("$@")

while [[ $# -gt 0 ]]; do
  case "$1" in
  --dirs)
    DIRS_MODE="true"
    shift
    ;;
  --no-zoxide)
    INCLUDE_ZOXIDE="false"
    shift
    ;;
  --directory)
    DIRECTORY="${2:-}"
    shift 2
    ;;
  --opencode-session)
    OPENCODE_SESSION="${2:-}"
    shift 2
    ;;
  --new-session)
    NEW_SESSION="true"
    shift
    ;;
  --root)
    ROOT="${2:-}"
    shift 2
    ;;
  --depth)
    DEPTH="${2:-}"
    shift 2
    ;;
  -l | --layout)
    if [[ -z "${2:-}" ]]; then
      die "--layout requires a value."
    fi
    LAYOUT="${2}"
    shift 2
    ;;
  --layout=*)
    LAYOUT="${1#*=}"
    shift 1
    ;;
  --debug)
    DEBUG="true"
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  --)
    shift
    break
    ;;
  *)
    die "Unknown argument: $1"
    ;;
  esac
done

QUERY=("$@")

if [[ -z "${ROOT}" ]]; then
  die "--root cannot be empty."
fi

if [[ ! -d "${ROOT}" ]]; then
  die "Root directory not found: ${ROOT}"
fi

if [[ ! "${DEPTH}" =~ ^[0-9]+$ ]]; then
  die "--depth must be a non-negative integer."
fi

if have fd; then
  FD_CMD="fd"
elif have fdfind; then
  FD_CMD="fdfind"
else
  FD_CMD=""
fi

# shellcheck source=scripts/tmux/tds/dirs.sh
. "$(dirname -- "${SELF}")/dirs.sh"
# shellcheck source=scripts/tmux/tds/session.sh
. "$(dirname -- "${SELF}")/session.sh"

if [[ "${DIRS_MODE}" == "true" ]]; then
  [[ -n "$FD_CMD" ]] || die "Missing required tool: fd"
  print_dirs "${QUERY[@]}"
  exit 0
fi

if ((${#QUERY[@]} > 0)); then
  die "Unexpected positional arguments: ${QUERY[*]}"
fi

if [[ -z "${LAYOUT}" ]]; then
  die "--layout cannot be empty."
fi

if [[ -n "$OPENCODE_SESSION" && -z "$DIRECTORY" ]]; then
  die "--opencode-session requires --directory."
fi

if [[ "$NEW_SESSION" == "true" && -z "$DIRECTORY" ]]; then
  die "--new-session requires --directory."
fi

if [[ -n "$DIRECTORY" ]]; then
  DIR="$DIRECTORY"
  [[ -d "$DIR" ]] || die "Selected directory not found: ${DIR}"
  require_apps tmux opencode
else
  [[ -n "$FD_CMD" ]] || die "Missing required tool: fd"
  require_apps tmux fzf opencode
fi

# shellcheck source=scripts/tmux/tds/layouts.sh
. "$(dirname -- "${SELF}")/layouts.sh"

validate_layout

if [[ "$NEW_SESSION" == "true" ]]; then
  create_new_session
  exit 0
fi

if [[ -z "${TMUX:-}" ]]; then
  echo "tmux is not running. Launching tmux..." >&2
  script_path="$(command -v tds 2>/dev/null || printf '%s' "$0")"
  script_path_escaped="$(escape_shell "${script_path}")"
  script_cmd="${script_path_escaped}"

  for arg in "${ORIG_ARGS[@]}"; do
    script_cmd+=" $(escape_shell "${arg}")"
  done

  if tmux has-session -t tds 2>/dev/null; then
    exec tmux attach -t tds
  fi

  tmux new-session -d -s tds -n tds
  tmux send-keys -t "tds:tds" "${script_cmd}" C-m
  exec tmux attach -t tds
fi

BASE_ROOT="${ROOT}"
while [[ -z "$DIRECTORY" ]]; do
  DIRS_FLAGS=()
  if [[ "${ROOT}" != "${BASE_ROOT}" ]]; then
    DIRS_FLAGS+=(--no-zoxide)
  fi
  RELOAD_CMD="$(escape_shell "${SELF}") --dirs ${DIRS_FLAGS[*]:-} --root $(escape_shell "${ROOT}") --depth ${DEPTH}"

  fzf_out="$(fzf --disabled \
    --expect=ctrl-d,ctrl-u \
    --prompt="> " \
    --header="${ROOT}" \
    --footer="enter: select · ctrl-d: enter dir · ctrl-u: go up · esc: cancel" \
    --bind "start:reload:${RELOAD_CMD}" \
    --bind "change:reload:sleep 0.1; ${RELOAD_CMD} -- {q} || true" \
    </dev/null || true)"

  if [[ -z "${fzf_out}" ]]; then
    exit 0
  fi

  key="$(head -n1 <<< "${fzf_out}")"
  sel="$(tail -n1 <<< "${fzf_out}")"

  if [[ -z "${sel}" ]]; then
    continue
  fi

  case "${key}" in
  ctrl-d)
    if [[ -d "${sel}" ]]; then
      ROOT="${sel}"
    fi
    ;;
  ctrl-u)
    if [[ "${ROOT}" != "${BASE_ROOT}" ]]; then
      ROOT="$(dirname -- "${ROOT}")"
    fi
    ;;
  *)
    DIR="${sel}"
    break
    ;;
  esac
done

if [[ ! -d "${DIR}" ]]; then
  die "Selected directory not found: ${DIR}"
fi

if have zoxide; then
  zoxide add "${DIR}" 2>/dev/null || true
fi

SESSION_NAME="$(tmux display-message -p '#{session_name}')"
WINDOW_ID="$(tmux display-message -p '#{window_id}')"
CURRENT_PANE_ID="$(tmux display-message -p '#{pane_id}')"
WINDOW_PANES="$(tmux display-message -p '#{window_panes}')"

rename_for_directory "$DIR"

if [[ -n "$OPENCODE_SESSION" ]]; then
  tmux set-option -q @opencode_session_id "$OPENCODE_SESSION"
else
  tmux set-option -qu @opencode_session_id 2>/dev/null || true
fi

if [[ "${DEBUG}" == "true" ]]; then
  debug_log "Session ${SESSION_NAME}, window ${WINDOW_ID}, panes ${WINDOW_PANES}"
  debug_log "Window size $(window_size "${CURRENT_PANE_ID}")"
  debug_log "Current pane size $(pane_size "${CURRENT_PANE_ID}")"
fi

apply_layout
