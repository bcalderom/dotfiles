#!/usr/bin/env bash
set -euo pipefail

OPENCODE_BIN="${OPENCODE_BIN:-/usr/bin/opencode}"
open_session_ids=""
recent_sessions='[]'
cursor=""

if command -v tmux >/dev/null 2>&1; then
  open_session_ids="$(
    { tmux list-panes -a -F '#{pane_current_command}	#{@opencode_session_id}' 2>/dev/null || true; } \
      | while IFS=$'\t' read -r command session_id; do
          if [[ "$command" == "opencode" && -n "$session_id" ]]; then
            printf '%s\n' "$session_id"
          fi
        done
  )"
fi

while :; do
  command=("$OPENCODE_BIN" api session.list --param parentID=null --param order=desc --param limit=100)
  [[ -z "$cursor" ]] || command+=(--param "cursor=$cursor")
  response="$("${command[@]}")"
  recent_sessions="$(jq -c \
    --arg open_session_ids "$open_session_ids" \
    --argjson recent "$recent_sessions" '
      if (.data | type) != "array" then error("Invalid OpenCode session response") else . end |
      ($open_session_ids | split("\n") | map(select(length > 0))) as $open |
      ($recent + [
        .data[] |
        select(.parentID == null and .time.archived == null) |
        select(.id as $id | ($open | index($id) | not)) |
        select((.location.directory | type) == "string" and .location.directory != "")
      ])[:10]
    ' <<< "$response")"

  [[ "$(jq 'length' <<< "$recent_sessions")" -lt 10 ]] || break
  next_cursor="$(jq -r '.cursor.next // empty' <<< "$response")"
  [[ -n "$next_cursor" ]] || break
  if [[ "$next_cursor" == "$cursor" ]]; then
    printf 'OpenCode returned a repeated session cursor\n' >&2
    exit 1
  fi
  cursor="$next_cursor"
done

jq -r '.[] | [
  .id,
  ((.title // .id) | gsub("[\\t\\r\\n]"; " ")),
  (.location.directory | gsub("[\\t\\r\\n]"; " "))
] | @tsv' <<< "$recent_sessions"
