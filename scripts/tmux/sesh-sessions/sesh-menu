#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
SCRIPT_PATH="${SCRIPT_DIR}/sesh-menu"

emit_row() {
  local value="$1"
  local source="$2"
  local kind="$3"
  local icon="$4"
  local color="$5"
  local display="${6:-$value}"
  local data="${7:-}"

  if [[ -n "${NO_COLOR:-}" ]]; then
    printf '%s\t%s\t%s\t%s %s' \
      "$value" "$source" "$kind" "$icon" "$display"
  else
    printf '%s\t%s\t%s\t\033[%sm%s\033[0m %s' \
      "$value" "$source" "$kind" "$color" "$icon" "$display"
  fi

  [[ -z "$data" ]] || printf '\t%s' "$data"
  printf '\n'
}

emit_sesh_row() {
  local mode="$1"
  local sesh_source="$2"
  local value="$3"
  local path="${4:-}"
  local source kind icon color

  case "$sesh_source" in
    tmux) source="tmux"; kind="session"; icon=""; color=34 ;;
    zoxide|dir) source="project"; kind="directory"; icon=""; color=36; value="$path" ;;
    tmuxinator|tmuxp) source="action"; kind="session"; icon=""; color=34 ;;
    config|config_wildcard)
      if [[ "$value" == cfg-* ]]; then
        source="config"
        case "$value" in
          cfg-dotfiles|cfg-nvim) kind="directory" ;;
          *) kind="file" ;;
        esac
      else
        source="action"
        kind="directory"
      fi
      icon=""
      color=90
      ;;
    *) return 0 ;;
  esac

  case "$mode:$source" in
    actions:action|configs:config) ;;
    actions:*|configs:*) return ;;
  esac

  if [[ "$source" == "config" || "$source" == "action" ]]; then
    case "$value" in
      cfg-*) icon=""; color=90 ;;
      terminal-*) icon=""; color=32 ;;
      vim-*) icon=""; color=32 ;;
      tds-*) icon=""; color=33 ;;
      ssh-*) icon="󰣀"; color=34 ;;
      notes-new) icon="󰎚"; color=35 ;;
      notes-*) icon="󰂺"; color=35 ;;
      files-*) icon=""; color=36 ;;
    esac
  fi

  local display="$value"
  if [[ "$source" == project && ( "$value" == "$HOME" || "$value" == "$HOME/"* ) ]]; then
    display="~${value#"$HOME"}"
  fi
  emit_row "$value" "$source" "$kind" "$icon" "$color" "$display" "$path"
}

list_rows() {
  local mode="${1:-home}"
  local freshness="${2:-}"
  local -a command
  local -a words=()
  local rows path display_path source value recent_rows word status

  if [[ "$mode" == find ]]; then
    read -r -a words <<< "$freshness"
    command=(fd -H -t d -E .Trash -E .git -E .cache -E node_modules)
    if ((${#words[@]} > 0)); then
      command+=(--full-path --fixed-strings --ignore-case -- "${words[0]}" "$HOME")
    else
      command+=(-d 2 . "$HOME")
    fi
    rows="$("${command[@]}")" || return $?
    for word in "${words[@]:1}"; do
      rows="$(grep -Fi -- "$word" <<< "$rows")" || {
        status=$?
        [[ "$status" == 1 ]] || return "$status"
      }
    done
    while IFS= read -r path; do
      [[ -n "$path" ]] || continue
      display_path="~${path#"$HOME"}"
      emit_row "$path" "find" "directory" "" 36 "$display_path"
    done <<< "$rows"
    return
  fi

  if [[ "$mode" == recent ]]; then
    recent_rows="$("$SCRIPT_DIR/opencode-recent")" || return $?
    while IFS=$'\t' read -r session_id title path; do
      [[ -n "$session_id" && -n "$path" ]] || continue
      if [[ "$path" == "$HOME" || "$path" == "$HOME/"* ]]; then
        display_path="~${path#"$HOME"}"
      else
        display_path="$path"
      fi
      emit_row "$session_id" "opencode" "session" "" 33 "$title  $display_path" "$path"
    done <<< "$recent_rows"
    return
  fi

  case "$mode" in
    home) command=(sesh list -t -c --json) ;;
    all) command=(sesh list --json) ;;
    sessions) command=(sesh list -t --json) ;;
    actions|configs) command=(sesh list -c --json) ;;
    projects) command=(sesh list -z --json) ;;
    *) printf 'Unknown list mode: %s\n' "$mode" >&2; return 2 ;;
  esac
  [[ "$freshness" != --fresh ]] || command+=(--no-cache)

  rows="$("${command[@]}")" || return $?
  rows="$(jq -r '
    if type != "array" then error("Invalid sesh list response") else . end |
    .[] | [.Src, .Name, (.Path // "")] |
    if any(.[]; type != "string" or test("[\\t\\r\\n]"))
    then error("Invalid sesh session fields") else join("\t") end
  ' <<< "$rows")" || return $?

  while IFS=$'\t' read -r source value path; do
    [[ -n "$source" && -n "$value" ]] || continue
    emit_sesh_row "$mode" "$source" "$value" "$path"
  done <<< "$rows"
}

kill_session() {
  local target="${1:-}"
  local source="${2:-}"
  local confirmation

  [[ "$source" == "tmux" && -n "$target" ]] || return 0
  confirmation="$(printf 'Cancel\nDelete\n' | fzf \
    --height=40% --layout=reverse --border \
    --border-label ' delete tmux session ' \
    --no-sort --no-multi --prompt 'confirm  ' \
    --header "Delete session: $target?" \
    --bind 'enter:accept,esc:abort')" || return 0
  [[ "$confirmation" == Delete ]] || return 0
  tmux kill-session -t "=$target"
}

resolve_directory() {
  local target="$1"
  local source="$2"
  local path="${3:-}"

  [[ -z "$path" ]] || target="$path"

  if [[ "$source" == "config" && -z "$path" ]]; then
    case "$target" in
      cfg-dotfiles) target="$HOME/dotfiles" ;;
      cfg-nvim) target="$HOME/.config/nvim/lua" ;;
    esac
  fi

  case "$target" in
    "~") target="$HOME" ;;
    \~/*) target="$HOME/${target#\~/}" ;;
  esac

  printf '%s' "$target"
}

open_directory() {
  local target="${1:-}"
  local source="${2:-}"
  local kind="${3:-}"
  local path="${4:-}"
  local -a opener

  [[ "$kind" == "directory" ]] || return 2
  [[ "$source" == "project" || "$source" == "find" || "$source" == "config" ]] || return 2
  target="$(resolve_directory "$target" "$source" "$path")"

  [[ -d "$target" ]] || return 3

  if command -v xdg-open >/dev/null 2>&1; then
    opener=(xdg-open)
  elif command -v gio >/dev/null 2>&1; then
    opener=(gio open)
  else
    return 127
  fi

  if [[ -n "${SESH_MENU_SYNC_OPEN:-}" ]]; then
    "${opener[@]}" "$target"
  else
    command -v setsid >/dev/null 2>&1 || return 127
    nohup setsid --fork -- "${opener[@]}" "$target" \
      </dev/null >/dev/null 2>&1
  fi
}

open_action() {
  if open_directory "${1:-}" "${2:-}" "${3:-}" "${4:-}"; then
    printf 'abort\n'
  fi

  return 0
}

preview_item() {
  local target="${1:-}"
  local source="${2:-}"
  local kind="${3:-}"
  local path="${4:-}"

  if [[ "$source" == opencode && -d "$path" ]]; then
    eza -alg --color=always --group-directories-first -- "$path"
    return
  fi

  if [[ "$kind" == "directory" && ( "$source" == "project" || "$source" == "find" ) ]]; then
    target="$(resolve_directory "$target" "$source" "$path")"
    eza -alg --color=always --group-directories-first -- "$target"
    return
  fi

  sesh preview "$target"
}

view_preview() {
  preview_item "${1:-}" "${2:-}" "${3:-}" "${4:-}" | less -R
}

print_header() {
  local source="${1:-none}"
  local kind="${2:-none}"
  local context

  case "$source:$kind" in
    opencode:session) context="enter resume  M-k/j preview  ^/ search" ;;
    tmux:session) context="enter switch  F2 rename  ^d delete (confirm)  M-k/j preview  ^/ search" ;;
    config:file) context="enter edit  M-k/j preview  ^/ search" ;;
    config:directory) context="enter launch  ^e explorer  M-k/j preview  ^/ search" ;;
    project:directory|find:directory) context="enter open tmux  ^e explorer  M-k/j preview  ^/ search" ;;
    action:*) context="enter launch  M-k/j preview  ^/ search" ;;
    *) context="type to search" ;;
  esac

  printf '  %s\n  esc close  ^a all ^t tmux ^o act ^g cfg ^x dirs ^f find ^r recent\n' "$context"
}

case "${1:-}" in
  --list)
    list_rows "${2:-home}" "${3:-}"
    exit
    ;;
  --kill)
    kill_session "${2:-}" "${3:-}"
    exit
    ;;
  --open)
    open_directory "${2:-}" "${3:-}" "${4:-}" "${5:-}"
    exit
    ;;
  --open-action)
    open_action "${2:-}" "${3:-}" "${4:-}" "${5:-}"
    exit
    ;;
  --preview)
    preview_item "${2:-}" "${3:-}" "${4:-}" "${5:-}"
    exit
    ;;
  --view)
    view_preview "${2:-}" "${3:-}" "${4:-}" "${5:-}"
    exit
    ;;
  --header)
    print_header "${2:-}" "${3:-}"
    exit
    ;;
esac

fzf_layout=(--layout=default)
[[ -n "${TMUX:-}" ]] || fzf_layout+=("--margin=20%,12.5%" --border)
initial_rows="$("$SCRIPT_PATH" --list home)"

if selection="$(
  printf '%s' "$initial_rows" | fzf \
    "${fzf_layout[@]}" \
    --no-sort --no-multi --ansi \
    --delimiter=$'\t' \
    --with-nth=4 \
    --accept-nth=1,2,3,5 \
    --border-label " sesh " \
    --prompt "home  " \
    --header "$("$SCRIPT_PATH" --header none none)" \
    --bind "esc:abort" \
    --bind "tab:down,btab:up" \
    --bind "start:unbind(change)" \
    --bind "change:reload(sleep 0.15; $SCRIPT_PATH --list find {q})" \
    --bind "focus:transform-header($SCRIPT_PATH --header {2} {3})" \
    --bind "alt-j:preview-down,alt-k:preview-up" \
    --bind "ctrl-a:transform($SCRIPT_DIR/fzf-view-actions all)+reload($SCRIPT_PATH --list all)" \
    --bind "ctrl-t:transform($SCRIPT_DIR/fzf-view-actions sessions)+reload($SCRIPT_PATH --list sessions)" \
    --bind "ctrl-o:transform($SCRIPT_DIR/fzf-view-actions actions)+reload($SCRIPT_PATH --list actions)" \
    --bind "ctrl-g:transform($SCRIPT_DIR/fzf-view-actions configs)+reload($SCRIPT_PATH --list configs)" \
    --bind "ctrl-x:transform($SCRIPT_DIR/fzf-view-actions projects)+reload($SCRIPT_PATH --list projects)" \
    --bind "ctrl-f:transform($SCRIPT_DIR/fzf-view-actions find)+reload($SCRIPT_PATH --list find {q})" \
    --bind "ctrl-r:transform($SCRIPT_DIR/fzf-view-actions recent)+reload($SCRIPT_PATH --list recent)" \
    --bind "ctrl-e:transform($SCRIPT_PATH --open-action {1} {2} {3} {5})" \
    --bind "ctrl-/:execute($SCRIPT_PATH --view {1} {2} {3} {5})" \
    --bind "ctrl-d:execute($SCRIPT_PATH --kill {1} {2})+transform($SCRIPT_DIR/fzf-view-actions home)+reload($SCRIPT_PATH --list home --fresh)" \
    --bind "f2:execute($SCRIPT_DIR/rename-session {1} {2})+transform($SCRIPT_DIR/fzf-view-actions home)+reload($SCRIPT_PATH --list home --fresh)" \
    --preview-window "right:55%" \
    --preview "sleep 0.08; exec $SCRIPT_PATH --preview {1} {2} {3} {5}"
)"; then
  :
else
  status=$?
  [[ "$status" == 1 || "$status" == 130 ]] && exit 0
  exit "$status"
fi
[[ -n "$selection" ]] || exit 0
IFS=$'\t' read -r target source kind path <<< "$selection"
if [[ "$source" == opencode ]]; then
  exec tds --directory "$path" --layout oc --opencode-session "$target" --new-session
fi

exec sesh connect "$target"
