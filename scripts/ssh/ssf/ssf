#!/usr/bin/env bash
set -euo pipefail

# ssf: user-friendly SSH launcher for ~/.ssh/config using fzf

CONFIG="${HOME}/.ssh/config"
COLLAPSED=0
FILTER_GROUP=""
INITIAL_QUERY=""

SELF_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SELF_PATH")" && pwd)"
SSF_TRANSFER_PATH="${SCRIPT_DIR}/ssf-transfer"

usage() {
  cat <<'EOF'
Usage: ssf [options] [alias]

Options:
  -c, --config PATH     SSH config file (default: ~/.ssh/config)
  --collapsed           Collapse by HostName (then choose alias for that host)
  -g, --group NAME      Filter by group prefix (e.g., wisemin, cenizas)
  -q, --query TEXT      Initial fzf query
  -h, --help            Show help

Keys (in selector):
  Enter   ssh
  Ctrl-S  scp transfer
  Ctrl-R  rsync transfer
  Ctrl-T  tmux new-window (if inside tmux)
  Ctrl-P  ping/port test
  Ctrl-K  copy "ssh <alias>"
  Ctrl-U  copy "user@hostname"
  Ctrl-I  copy "hostname"
  Ctrl-E  edit ssh config
  Ctrl-Y  run remote command and copy stdout
EOF
}

need_cmd() { command -v "$1" >/dev/null 2>&1; }
die() { echo "Error: $*" >&2; exit 1; }
editor() { echo "${EDITOR:-vi}"; }

ensure_deps() {
  need_cmd fzf || die "fzf not found. Install fzf first."
  need_cmd ssh || die "ssh not found."
}

[[ -f "${SCRIPT_DIR}/ssf-hosts" ]] || die "Missing helper: ${SCRIPT_DIR}/ssf-hosts"
[[ -f "${SCRIPT_DIR}/ssf-actions" ]] || die "Missing helper: ${SCRIPT_DIR}/ssf-actions"
[[ -f "$SSF_TRANSFER_PATH" ]] || die "Missing helper: $SSF_TRANSFER_PATH"
source "${SCRIPT_DIR}/ssf-hosts"
source "${SCRIPT_DIR}/ssf-actions"

internal_mode() {
  local mode="$1"
  shift
  case "$mode" in
    --_dump) dump_mode "${1:-$CONFIG}" ;;
    --_rows) dump_mode "${1:-$CONFIG}" | build_display_rows ;;
    --_scp_cmd) bash "$SSF_TRANSFER_PATH" --_cmd scp "$@" ;;
    --_rsync_cmd) bash "$SSF_TRANSFER_PATH" --_cmd rsync "$@" ;;
    --_copy_remote_stdout)
      local alias="${1:-}" remote_cmd="${2:-}"
      [[ -n "$alias" ]] || die "Missing alias"
      [[ -n "$remote_cmd" ]] || die "Missing remote command"
      copy_remote_stdout "$alias" "$remote_cmd"
      ;;
    *) return 1 ;;
  esac
}

select_collapsed_host() {
  local base="$1" collapsed selection
  collapsed="$(printf '%s\n' "$base" | collapsed_view)"
  selection="$(printf '%s\n' "$collapsed" | fzf \
    --prompt="HostName> " --query="$INITIAL_QUERY" --delimiter=$'\t' --with-nth=1,2,3,4 \
    --preview='bash -c '\''
      IFS=$'\''\t'\'' read -r host users groups roles aliases <<< "$1"
      printf "HostName: %s\nUsers:    %s\nGroups:   %s\nRoles:    %s\n\nAliases:\n" "$host" "$users" "$groups" "$roles"
      printf "%s\n" "$aliases" | tr "," "\n" | sed "s/^/  - /"
    '\'' _ "{}"' --preview-window=right:60%:wrap)" || return 1
  printf '%s' "${selection%%$'\t'*}"
}

select_action() {
  local data="$1" selection key line sep header
  sep="$(printf '%*s' "${COLUMNS:-80}" '' | tr ' ' '-')"
  header="${sep}"$'\n'"Enter: ssh | Ctrl-S: scp | Ctrl-R: rsync | Ctrl-T: tmux"$'\n'"Ctrl-P: test | Ctrl-K: copy ssh | Ctrl-U: copy user@host"$'\n'"Ctrl-I: copy host | Ctrl-E: edit | Ctrl-Y: copy cmd stdout"
  selection="$(printf '%s\n' "$data" | fzf \
    --prompt="SSH> " --query="$INITIAL_QUERY" --delimiter=$'\t' --with-nth=1 --header-lines=1 \
    --expect=enter,ctrl-s,ctrl-r,ctrl-t,ctrl-p,ctrl-k,ctrl-u,ctrl-i,ctrl-e,ctrl-y \
    --preview="$(preview_cmd "$CONFIG")" --preview-window=right:60%:wrap --header="$header")" || return 1
  key="${selection%%$'\n'*}"
  line="${selection#*$'\n'}"
  [[ "$line" != "$selection" && -n "$line" ]] || return 1
  printf '%s\n%s' "$key" "$line"
}

main() {
  if [[ "${1:-}" == --_* ]]; then
    local mode="$1"
    shift
    internal_mode "$mode" "$@" || die "Unknown internal option: $mode"
    exit 0
  fi

  ensure_deps
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -c|--config) CONFIG="${2:-}"; shift 2 ;;
      --collapsed) COLLAPSED=1; shift ;;
      -g|--group) FILTER_GROUP="${2:-}"; shift 2 ;;
      -q|--query) INITIAL_QUERY="${2:-}"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      --) shift; break ;;
      -*) die "Unknown option: $1" ;;
      *) exec ssh "$1" ;;
    esac
  done

  local base data host action line display alias user group role variant result
  base="$(dump_mode "$CONFIG")"
  if [[ -n "$FILTER_GROUP" ]]; then
    base="$(printf '%s\n' "$base" | awk -F$'\t' -v G="$FILTER_GROUP" '$4==G{print}')"
  fi
  [[ -n "$base" ]] || die "No SSH hosts found (check config: $CONFIG)"

  if [[ "$COLLAPSED" -eq 1 ]]; then
    host="$(select_collapsed_host "$base")" || exit 0
    data="$(pick_alias_for_host "$host" "$CONFIG")" || exit 0
  else
    data="$(printf '%s\n' "$base" | build_display_rows)"
  fi

  result="$(select_action "$data")" || exit 0
  action="${result%%$'\n'*}"
  line="${result#*$'\n'}"
  IFS=$'\t' read -r display alias host user group role variant <<< "$line"
  run_action "$action" "$alias" "$host" "$user" "$CONFIG"
}

main "$@"
