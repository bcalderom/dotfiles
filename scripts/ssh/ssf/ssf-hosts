# Host parsing, history and fzf presentation helpers for ssf.

hist_file() { echo "${XDG_CACHE_HOME:-$HOME/.cache}/ssf-history"; }

parse_config() {
  local cfg="$1"
  [[ -f "$cfg" ]] || die "Config not found: $cfg"
  awk '
    function trim(s){ gsub(/\r/,"",s); sub(/^[ \t]+/,"",s); sub(/[ \t]+$/,"",s); return s }
    function flush(aliases, hostname, user,   n, a, parts, i, grp, role, variant, j, parts2) {
      if (aliases=="" || hostname=="" || user=="") return
      n = split(aliases, parts, " ")
      for (i=1; i<=n; i++) {
        a=parts[i]; if (a=="" || a=="*") continue
        n2=split(a,parts2,"_")
        if (n2==1) { grp=""; role=parts2[1] } else { grp=parts2[1]; role=parts2[2] }
        variant=""
        if (length(parts2[3])) { variant=parts2[3]; for (j=4; j in parts2; j++) variant=variant "_" parts2[j] }
        print a "\t" hostname "\t" user "\t" grp "\t" role "\t" variant
      }
    }
    BEGIN { aliases=""; hostname=""; user="" }
    { gsub(/\r/,"",$0) }
    /^[ \t]*#/ || /^[ \t]*$/ { next }
    /^[ \t]*Host[ \t]+/ {
      flush(aliases,hostname,user); line=$0; sub(/^[ \t]*Host[ \t]+/,"",line)
      line=trim(line); gsub(/[ \t]+/," ",line); aliases=line; hostname=""; user=""; next
    }
    /^[ \t]*HostName[ \t]+/ { line=$0; sub(/^[ \t]*HostName[ \t]+/,"",line); hostname=trim(line); next }
    /^[ \t]*User[ \t]+/ { line=$0; sub(/^[ \t]*User[ \t]+/,"",line); user=trim(line); next }
    END { flush(aliases,hostname,user) }
  ' "$cfg"
}

sort_by_history() {
  local hist
  hist="$(hist_file)"
  mkdir -p "$(dirname "$hist")" 2>/dev/null || true
  touch "$hist" 2>/dev/null || true
  awk -F'\t' -v HIST="$hist" '
    BEGIN {
      while ((getline line < HIST)>0) { gsub(/\r/,"",line); if (line!="") order[++n]=line }
      close(HIST); for (i=1;i<=n;i++) rank[order[i]]=n-i
    }
    { r=($1 in rank ? rank[$1] : 999999); print r "\t" $0 }
  ' | sort -t$'\t' -k1,1n -k2,2 | cut -f2-
}

update_history() {
  local alias="$1" hist
  hist="$(hist_file)"
  mkdir -p "$(dirname "$hist")" 2>/dev/null || true
  touch "$hist" 2>/dev/null || true
  awk -v A="$alias" '$0!=A && $0!="" {print} END{print A}' "$hist" > "${hist}.tmp" && mv "${hist}.tmp" "$hist"
}

dump_mode() { parse_config "$1" | sort_by_history; }

build_display_rows() {
  awk -F$'\t' '
    function resolve_ip(host, cmd,line,parts,ip) {
      if (host in cache) return cache[host]
      ip="-"; cmd="getent ahosts \"" host "\" 2>/dev/null"
      if ((cmd|getline line)>0) { split(line,parts,/[ \t]+/); if (parts[1]!="") ip=parts[1] }
      close(cmd); cache[host]=ip; return ip
    }
    BEGIN {
      cw=12; sw=14; iw=16; uw=12
      print sprintf("%-*s  %-*s  %-*s  %-*s",cw,"Client",sw,"Server",iw,"IP Address",uw,"User")
    }
    {
      alias=$1; host=$2; user=$3; client=$4; server=$5; variant=($6=="" ? "-" : $6)
      display=sprintf("%-*s  %-*s  %-*s  %-*s",cw,client,sw,server,iw,resolve_ip(host),uw,user)
      print display "\t" alias "\t" host "\t" user "\t" client "\t" server "\t" variant
    }
  '
}

preview_cmd() {
  local cfg="$1" self="$SELF_PATH"
  cat <<EOF
bash -c '
  IFS=\$'\''\t'\'' read -r display alias host user client server variant <<< "\$1"
  self="\$3"
  ip="-"
  if ip_line="\$(getent ahosts "\$host" 2>/dev/null | head -n1)" && [[ -n "\$ip_line" ]]; then ip="\${ip_line%%[[:space:]]*}"; fi
  printf "Client:     %s\nServer:     %s\nIP Address: %s\nUser:       %s\n\n" "\$client" "\$server" "\$ip" "\$user"
  printf "SSH alias:\n  %s\nCommand:\n  ssh %s\n\nOther aliases on same HostName:\n" "\$alias" "\$alias"
  found=0
  while IFS=\$'\''\t'\'' read -r a h u g r v; do
    [[ "\$h" == "\$host" && "\$a" != "\$alias" ]] || continue
    printf "  - %s (%s)\\n" "\$a" "\$u"; found=1
  done < <("\$self" --_dump "$cfg" 2>/dev/null || true)
  [[ "\$found" -eq 1 ]] || echo "  (none)"
' _ "{}" "$cfg" "$self"
EOF
}

collapsed_view() {
  awk -F'\t' '
    function adduniq(map,key,val,k) { k=key SUBSEP val; if (!(k in seen)) { seen[k]=1; map[key]=map[key] (map[key]==""?"":", ") val }; return map[key] }
    { host=$2; users[host]=adduniq(users,host,$3); grps[host]=adduniq(grps,host,$4); roles[host]=adduniq(roles,host,$5); aliases[host]=aliases[host] (aliases[host]==""?"":", ") $1 }
    END { for (host in aliases) printf "%s\t%s\t%s\t%s\t%s\n",host,users[host],grps[host],roles[host],aliases[host] }
  ' | sort
}

pick_alias_for_host() {
  local host="$1" cfg="$2" list selection
  list="$(dump_mode "$cfg" | awk -F$'\t' -v H="$host" '$2==H{print}')"
  [[ -n "$list" ]] || return 1
  selection="$(printf '%s\n' "$list" | build_display_rows | fzf \
    --prompt="Alias for ${host}> " --delimiter=$'\t' --with-nth=1 --header-lines=1 \
    --preview="$(preview_cmd "$cfg")" --preview-window=right:60%:wrap)" || return 1
  printf '' | build_display_rows
  printf '%s' "$selection"
}
